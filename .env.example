# PromERP — переменные окружения.
# Скопируйте в .env (bash bin/setup.sh делает это автоматически) и заполните.
# Файл .env в git не попадает.

# --- Окружение --------------------------------------------------------------
# PRODUCTION | STAGING | TESTING | DEVELOPMENT
KOHANA_ENV=DEVELOPMENT

# 1 — E_DEPRECATED считается ошибкой (строгий режим, см. public_html/index.php)
STRICT_DEPRECATIONS=0

# --- PostgreSQL -------------------------------------------------------------

# DEFAULT
DB_DEFAULT_HOST=127.0.0.1
DB_DEFAULT_PORT=5432
DB_DEFAULT_NAME=promerp
DB_DEFAULT_USER=promerp
DB_DEFAULT_PASS=promerp
DB_DEFAULT_SCHEMA=public


# Дополнительные базы (модули MDM/онтологии). Если не заданы — используется DB_DEFAULT_NAME.
DB_MDM_HOST=127.0.0.1
DB_MDM_PORT=5432
# Отдельная база обязательна: у MDM собственные users/types и схема конфликтует с default.
DB_MDM_NAME=promerp_mdm
DB_MDM_USER=promerp
DB_MDM_PASS=promerp
DB_MDM_SCHEMA=public



# Хранилище демонстрационного стенда (erp811_demo, страница /demo).
# database: отдельная БД; schema: изолированная схема в основной БД без новой БД.
DEMO_STORAGE=database
DB_DEMO_NAME=promerp_demo
DB_DEMO_SCHEMA=promerp_demo
# Только для осознанного schema-mode при APP_ENV=production:
DEMO_ALLOW_SHARED_PRODUCTION=0
# quick: 8 заказов/30 дней; standard: 16/60; full: 30/120.
DEMO_BUILD_PROFILE=quick

# --- Секреты приложения -----------------------------------------------------
# Генерируются автоматически: bash bin/setup.sh
COOKIE_SALT=
AUTH_HASH_KEY=

# --- Доверенные хосты -------------------------------------------------------
# Дополнительные хосты через запятую (попадают в url.trusted_hosts)
TRUSTED_HOSTS=promerp.ru,test.promerp.ru

# --- Почта (SMTP) -----------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=

# --- LLM-провайдеры ---------------------------------------------------------
TOOLFORGE_API_KEY=
TOOLFORGE_API_URL=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# --- Учётная запись администратора (make seed) ------------------------------
ADMIN_EMAIL=admin@promerp.local
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# --- Dev-сервер -------------------------------------------------------------
PORT=8080
